# 示例模板：两条 WP 函数更新任务；实际使用请复制到仓库外，替换成自己的任务与路径。
# 由 deploy.sh 管理，请勿手工修改。
# 适用系统时区：Asia/Shanghai（UTC+8，无夏令时）。
# 触发时间为北京时间 16:00 与 00:00。
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LANG=C.UTF-8
TZ=Asia/Shanghai
MAILTO=""

0 16 * * * root /bin/bash /www/sh/wp-functions-update/update_wp_functions.sh --src /www/functions4.php >>/var/log/wp-functions-update.log 2>&1
0 0  * * * root /bin/bash /www/sh/wp-functions-update/update_wp_functions.sh --src /www/functions24.php >>/var/log/wp-functions-update.log 2>&1
