# 邮件发信配置示例。复制为 notify.env 后填写,并执行 chmod 600 notify.env。
# 全部字段按 KEY=VALUE 书写,不要在值两侧加引号。
# 文件权限建议 600,且只对运行拨测的系统用户可读。

SMTP_URL=smtps://smtp.example.com:465
SMTP_USER=monitor@example.com
SMTP_PASS=替换为邮箱授权码
MAIL_FROM=monitor@example.com
MAIL_TO=ops@example.com
MAIL_TIMEOUT=30

# 使用 smtp:// 且要求 STARTTLS 时取消下一行注释。
# SMTP_STARTTLS=1

# 使用私有 CA 时取消下一行注释并填写证书路径。
# SMTP_CA_BUNDLE=/etc/ssl/certs/private-ca.pem
